# SQL files applied by deploy/remote-deploy.sh, in order, paths relative to the repo root.
#
# - Empty database: every file is applied once (errors such as duplicate columns
#   are skipped) and recorded in the `_deploy_migrations` table.
# - Existing database: only files not yet recorded are applied, and any error
#   fails the deploy. To change the schema, add a NEW file at the end of this list.
#
# Not listed: migrations/create_chat_system.sql (PostgreSQL version),
# migrations/add_image_to_projects.sql (covered by add_images_to_entities.sql).
database/schema.sql
database/migration_v2.sql
database/migration_v3.sql
database/migration_v4.sql
database/migration_v5.sql
database/migration_v6.sql
database/migration_v7.sql
database/migration_v8.sql
database/migration_v9.sql
database/migration_v10.sql
database/migration_v11.sql
database/migrations/create_project_invitations.sql
database/migrations/add_uuid_slug_deleted_to_projects.sql
database/migrations/add_images_to_entities.sql
database/migrations/add_password_reset_tokens.sql
database/migrations/add_mobile_gender_to_users.sql
database/migrations/create_chat_system_mysql.sql
deploy/messages_merge.sql
database/migrations/create_blogs.sql
deploy/blogs_slug.sql
database/migrations/page_content.sql
database/migrations/update_task_status.sql
database/migrations/create_daily_reports.sql
database/migrations/add_blocker_type.sql
database/migrations/add_task_comments_activity.sql
database/migrations/add_comment_history_actions.sql
deploy/schema_sync.sql
deploy/payments_provider_role.sql
